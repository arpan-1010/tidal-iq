{
  "name": "@whale/api",
  "version": "0.0.1",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "db:push": "bun drizzle-kit push --config=drizzle.config.ts",
    "db:studio": "bun drizzle-kit studio --config=drizzle.config.ts",
    "db:generate": "bun drizzle-kit generate --config=drizzle.config.ts"
  },
  "dependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "@whale/shared": "workspace:*",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "hono": "latest",
    "postgres": "^3.4.9",
    "zod": "latest"
  },
  "devDependencies": {
    "bun-types": "^1.4.2",
    "drizzle-kit": "^0.31.11"
  }
}