# Blockchain
ALCHEMY_API_KEY=get_your_alehcmy_key

# Database
DATABASE_URL=get_your_url_from_supbase
ETH_THRESHOLD_USD=1000000
SOL_THRESHOLD_USD=1000000
BTC_THRESHOLD_USD=5000000

# AI
AI_ENABLED=true
NVIDIA_API_KEY=get_your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

AI_FAST_MODELS=nvidia/nemotron-3-super-120b-a12b,nvidia/nemotron-3.5-lightning-30b-a3b,google/gemma-4-31b-it
AI_STRONG_MODELS=nvidia/nemotron-3-super-120b-a12b,deepseek-ai/deepseek-v4.1-flash,z-ai/glm-5.3-flash
AI_NO_THINK_MODELS=nvidia/nemotron-3-super-120b-a12b

AI_EMBED_MODEL=nvidia/nemotron-3-embed-1b
AI_EMBED_TRUNCATE=true

# Limits
AI_RPM=30
AI_DAILY_TOKEN_BUDGET=400000
AI_COST_PER_1K_TOKENS=0
AI_MIN_IMPACT=40

# Feature flags
AI_FEATURE_SEARCH=true
AI_FEATURE_CHAT=true
AI_FEATURE_PROFILES=true
AI_FEATURE_NARRATIVES=true

TELEGRAM_BOT_TOKEN=get_your_telegram_bot_token
TELEGRAM_CHAT_ID=get_your_chat_id
AI_DIGEST_HOUR_UTC=3

# App
FRONTEND_URL=http://localhost:3000
PORT=4000